# Copy this file to ".env" and fill in your values.

# PostgreSQL database URL (use a free Neon or Supabase database)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Your Cash App $cashtag (without the $). Players pay this tag.
CASHAPP_CASHTAG=stockhunger

# Admin panel password (/admin). Change this before going live.
ADMIN_PASSWORD=change-me-please

# Bearer secret for scheduled settlement: POST /api/admin/settle
CRON_SECRET=change-me-too

# Optional payout provider for the automated payout bot (leave empty to pay manually)
PAYOUT_PROVIDER_URL=
PAYOUT_PROVIDER_KEY=
